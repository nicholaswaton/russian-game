// --- GAME LOGIC ---
const parseCSV = (str) => {
  const result = [];
  let row = [];
  let inQuotes = false;
  let val = '';
  for (let i = 0; i < str.length; i++) {
    let char = str[i];
    if (char === '"') {
      inQuotes = !inQuotes;
    } else if (char === ',' && !inQuotes) {
      row.push(val);
      val = '';
    } else if (char === '\n' && !inQuotes) {
      row.push(val);
      result.push(row);
      row = [];
      val = '';
    } else if (char !== '\r') {
      val += char;
    }
  }
  row.push(val);
  result.push(row);
  
  const headers = result[0].map(h => h.trim());
  return result.slice(1).filter(r => r.length > 1).map(r => {
    let obj = {};
    headers.forEach((h, i) => obj[h] = r[i] ? r[i].trim().replace(/^"|"$/g, '') : '');
    return obj;
  });
};

async function generateSentencesWithGemini(vocabWord) {
  const direction = Math.random() > 0.5 ? 'RU_TO_EN' : 'EN_TO_RU';
  let retries = 5;
  let delay = 1000;
  
  while(retries > 0) {
      try {
        const prompt = `You are a Russian language teacher creating a multiple-choice quiz. 
        I am giving you a target vocabulary word in Russian: "${vocabWord.Russian}" and its English translation: "${vocabWord.English}".
        
        Create a short, simple, grammatically correct sentence using this word. 
        
        If the direction is RU_TO_EN, generate:
        1. The correct Russian sentence.
        2. The correct English translation of that sentence.
        3. Three INCORRECT English translations that use similar grammar or vocabulary but are wrong.
        
        If the direction is EN_TO_RU, generate:
        1. The correct English sentence.
        2. The correct Russian translation of that sentence.
        3. Three INCORRECT Russian translations that are grammatically valid but wrong.
        
        Direction: ${direction}
        
        Respond ONLY with a valid JSON object matching this schema exactly, with no markdown formatting or backticks:
        {
            "questionText": "The sentence to display to the user",
            "correctAnswer": "The correct translation",
            "wrongAnswer1": "An incorrect translation",
            "wrongAnswer2": "An incorrect translation",
            "wrongAnswer3": "An incorrect translation"
        }`;

        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                contents: [{ parts: [{ text: prompt }] }],
                generationConfig: { 
                    responseMimeType: "application/json"
                }
            })
        });

        const data = await response.json();
        if (data.error) throw new Error(data.error.message);
        
        const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!rawText) throw new Error("No text returned from Gemini");
        
        const parsedData = JSON.parse(rawText);
        
        return {
            direction: direction,
            questionText: parsedData.questionText,
            options: [
                { text: parsedData.correctAnswer, isCorrect: true },
                { text: parsedData.wrongAnswer1, isCorrect: false },
                { text: parsedData.wrongAnswer2, isCorrect: false },
                { text: parsedData.wrongAnswer3, isCorrect: false }
            ]
        };

      } catch (error) {
          retries--;
          if(retries === 0) return null; 
          await new Promise(res => setTimeout(res, delay));
          delay *= 2;
      }
  }
}

export default function App() {
  const [vocabList, setVocabList] = useState([]);
  const [unusedVocab, setUnusedVocab] = useState([]); 
  const [isGameLoading, setIsGameLoading] = useState(true);
  const [isQuestionLoading, setIsQuestionLoading] = useState(false);
  
  const [currentWordObj, setCurrentWordObj] = useState(null);
  const [currentSentenceData, setCurrentSentenceData] = useState(null);
  
  const [selectedAnswer, setSelectedAnswer] = useState(null);
  const [isCorrect, setIsCorrect] = useState(null);
  const [isVictory, setIsVictory] = useState(false);
  
  const [score, setScore] = useState(0);
  const [streak, setStreak] = useState(0);
  const [totalWords, setTotalWords] = useState(0);

  // Decoration state
  const [CurrentIcon, setCurrentIcon] = useState(() => DECORATIONS[0]);

  useEffect(() => {
    fetchVocabulary();
  }, []);

  const shuffleArray = (array) => {
    return [...array].sort(() => Math.random() - 0.5);
  };

  const updateDecoration = () => {
    const randomIndex = Math.floor(Math.random() * DECORATIONS.length);
    setCurrentIcon(() => DECORATIONS[randomIndex]);
  };

  const fetchVocabulary = async () => {
    setIsGameLoading(true);
    try {
      const response = await fetch('https://docs.google.com/spreadsheets/d/1xlyUGeFUNIE6XopIeiD_ZVbs67wVokKXdS3cripao3w/export?format=csv');
      const text = await response.text();
      const allData = parseCSV(text);
      
      const validData = allData.filter(item => item.Russian && item.English);
      const shuffled = shuffleArray(validData);
      const selectedVocab = shuffled.slice(0, 50);
      
      setVocabList(selectedVocab);
      setUnusedVocab(selectedVocab);
      setTotalWords(selectedVocab.length);
      setScore(0);
      setStreak(0);
      setIsVictory(false);
      
      generateNextQuestion(selectedVocab);
    } catch (error) {
      console.error("Failed to load vocabulary", error);
      setIsGameLoading(false);
    }
  };

  const generateNextQuestion = async (availableWords) => {
    if (availableWords.length === 0) {
      setIsVictory(true);
      return;
    }

    setIsQuestionLoading(true);
    updateDecoration(); // Change the icon

    const correctIndex = Math.floor(Math.random() * availableWords.length);
    const targetWord = availableWords[correctIndex];
    
    const sentenceData = await generateSentencesWithGemini(targetWord);
    
    if (sentenceData) {
        sentenceData.options = shuffleArray(sentenceData.options);
        setCurrentWordObj(targetWord);
        setCurrentSentenceData(sentenceData);
        setSelectedAnswer(null);
        setIsCorrect(null);
    } else {
         const newUnused = availableWords.filter((_, idx) => idx !== correctIndex);
         setUnusedVocab(newUnused);
         generateNextQuestion(newUnused);
         return;
    }

    setIsQuestionLoading(false);
    setIsGameLoading(false);
  };

  const handleOptionClick = (option) => {
    if (selectedAnswer) return; 
    
    setSelectedAnswer(option);
    
    if (option.isCorrect) {
      setIsCorrect(true);
      setScore(s => s + 10);
      setStreak(s => s + 1);
    } else {
      setIsCorrect(false);
      setStreak(0);
    }
  };

  const handleContinue = () => {
    let newUnused = unusedVocab;
    if (isCorrect && currentWordObj) {
        newUnused = unusedVocab.filter(word => word.Russian !== currentWordObj.Russian);
        setUnusedVocab(newUnused);
    }
    generateNextQuestion(newUnused);
  };

  if (isGameLoading) {
    return (
      <div className="flex flex-col h-screen items-center justify-center font-sans space-y-4 bg-white">
        <RefreshCw className="w-10 h-10 animate-spin text-green-500" />
        <p className="text-xl font-bold text-gray-500">Loading your lesson...</p>
      </div>
    );
  }

  const getButtonClass = (option) => {
    const baseClass = "w-full p-4 sm:p-5 rounded-2xl border-b-4 font-bold text-lg sm:text-xl transition-all duration-100 flex items-center justify-center active:border-b-0 active:translate-y-1 ";
    
    if (!selectedAnswer) {
      return baseClass + "bg-white border-gray-200 text-gray-700 hover:bg-gray-50 hover:border-gray-300";
    }

    if (option.isCorrect) {
      return baseClass + "bg-green-100 border-green-500 text-green-600";
    }
    
    if (selectedAnswer === option && !isCorrect) {
      return baseClass + "bg-red-100 border-red-500 text-red-600";
    }

    return baseClass + "bg-white border-gray-200 text-gray-400 opacity-50 cursor-not-allowed";
  };

  const progressPercentage = ((totalWords - unusedVocab.length + (selectedAnswer && isCorrect ? 1 : 0)) / totalWords) * 100;

  return (
    <div className="flex flex-col min-h-screen bg-white font-sans text-gray-800">

      {/* HEADER */}
      <header className="flex items-center justify-between px-6 py-4 max-w-4xl w-full mx-auto">
        <div className="w-6" />
        
        <div className="flex-1 mx-4 sm:mx-6 bg-gray-200 h-4 rounded-full overflow-hidden">
          <div 
            className="bg-green-500 h-full rounded-full transition-all duration-300"
            style={{ width: `${Math.max(0, Math.min(progressPercentage, 100))}%` }}
          />
        </div>

        <div className="flex items-center space-x-4">
          <div className="flex items-center space-x-2 text-yellow-500 font-bold text-lg">
            <Star fill={streak > 0 ? "currentColor" : "none"} className="w-6 h-6" />
            <span>{streak}</span>
          </div>
          <button 
            onClick={fetchVocabulary} 
            className="p-2 text-gray-400 hover:text-blue-500 hover:bg-blue-50 rounded-full transition-colors"
            title="Restart Game with New Words"
            disabled={isQuestionLoading}
          >
            <RefreshCw className={`w-6 h-6 ${isQuestionLoading ? 'animate-spin opacity-50' : ''}`} />
          </button>
        </div>
      </header>

      {/* MAIN CONTENT */}
      <main className="flex-1 flex flex-col items-center justify-center max-w-4xl w-full mx-auto px-6 mt-4 sm:mt-10 mb-32">
        
        {isVictory ? (
          <div className="text-center mt-10 animate-in fade-in zoom-in duration-500 p-8">
            <Trophy className="w-24 h-24 text-yellow-400 mx-auto mb-6" />
            <h1 className="text-4xl font-extrabold text-gray-800 mb-4">Lesson Complete!</h1>
            <p className="text-gray-500 mb-8 text-xl">You successfully translated all {totalWords} sentences.</p>
            <div className="bg-yellow-50 rounded-2xl p-6 border-2 border-yellow-200 mb-8 inline-block">
                <p className="text-2xl font-bold text-yellow-600 mb-2">Final Score: {score}</p>
                <p className="text-lg text-yellow-500 font-medium">Longest Streak: {streak} 🔥</p>
            </div>
            <div>
              <button
                onClick={fetchVocabulary}
                className="px-8 py-4 rounded-2xl font-bold text-lg uppercase tracking-wider text-white bg-blue-500 border-blue-600 border-b-4 hover:bg-blue-400 active:border-b-0 active:translate-y-1 transition-all"
              >
                Learn New Words
              </button>
            </div>
          </div>
        ) : isQuestionLoading ? (
            <div className="w-full flex flex-col items-center justify-center space-y-4 opacity-50 p-10">
               <Loader2 className="w-12 h-12 animate-spin text-blue-500" />
               <p className="text-xl font-bold text-gray-600">Generating sentence...</p>
            </div>
        ) : currentSentenceData && (
          <div className="w-full flex flex-col items-center">
            
            <div className="w-full max-w-3xl flex justify-between items-end mb-6">
               <h2 className="text-xl font-bold text-gray-800">
                {currentSentenceData.direction === 'RU_TO_EN' 
                  ? "Select the correct English translation" 
                  : "Select the correct Russian translation"}
               </h2>
               
               {/* SIDE DECORATION */}
               <div className="hidden sm:block w-20 h-20 opacity-90 transition-all duration-300">
                   <CurrentIcon />
               </div>
            </div>

            <div className="w-full text-center mb-8 flex flex-col items-center justify-center min-h-[120px]">
              <h1 className="text-3xl sm:text-4xl font-extrabold text-gray-800 mb-2 drop-shadow-sm">
                {currentSentenceData.questionText}
              </h1>
              {/* Mobile decoration - appears under text on small screens */}
              <div className="sm:hidden w-16 h-16 mt-4 opacity-90 transition-all duration-300">
                   <CurrentIcon />
              </div>
            </div>

            <div className="grid grid-cols-1 gap-4 w-full max-w-3xl">
              {currentSentenceData.options.map((option, index) => (
                <button
                  key={index}
                  onClick={() => handleOptionClick(option)}
                  disabled={selectedAnswer !== null}
                  className={getButtonClass(option)}
                >
                  <span className="text-center leading-tight">{option.text}</span>
                </button>
              ))}
            </div>
          </div>
        )}
      </main>

      {/* FEEDBACK BANNER */}
      {selectedAnswer && !isVictory && !isQuestionLoading && (
        <div className={`fixed bottom-0 w-full p-6 sm:p-10 border-t-2 animate-in slide-in-from-bottom-10 flex flex-col sm:flex-row items-center justify-between z-50
          ${isCorrect ? 'bg-green-100 border-green-200' : 'bg-red-100 border-red-200'}
        `}>
          <div className="flex items-center space-x-4 w-full max-w-3xl mx-auto">
            <div className={`p-2 rounded-full ${isCorrect ? 'bg-green-500' : 'bg-red-500'}`}>
              {isCorrect ? (
                <CheckCircle className="w-8 h-8 text-white" />
              ) : (
                <XCircle className="w-8 h-8 text-white" />
              )}
            </div>
            <div className="flex-1">
              <h3 className={`text-2xl font-black ${isCorrect ? 'text-green-600' : 'text-red-600'}`}>
                {isCorrect ? 'Excellent!' : 'Correct solution:'}
              </h3>
              {!isCorrect && (
                <p className="text-red-500 text-lg font-medium mt-1">
                  {currentSentenceData.options.find(o => o.isCorrect).text}
                </p>
              )}
            </div>
            
            <button
              onClick={handleContinue}
              className={`w-full mt-4 sm:mt-0 sm:w-auto px-8 py-3 rounded-2xl font-bold text-lg uppercase tracking-wider text-white border-b-4 active:border-b-0 active:translate-y-1 transition-all
                ${isCorrect ? 'bg-green-500 border-green-600 hover:bg-green-400' : 'bg-red-500 border-red-600 hover:bg-red-400'}
              `}
            >
              Continue
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
